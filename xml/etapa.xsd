<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.uniovi.es"
	xmlns="http://www.uniovi.es"
	elementFormDefault="qualified">

	<xs:element name="etapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="nombre_Etapa" />
				<xs:element ref="num_Etapa" />
				<xs:element ref="longitud_Etapa" />
				<xs:element ref="fecha" />
				<xs:element ref="tiempo_Ganador" />
				<xs:element ref="velocidad_Media_Ganador" />
				<xs:element ref="desnivel" />
				<xs:element ref="ciudad_Inicio" />
				<xs:element ref="ciudad_Fin" />
				<xs:element ref="tipo_Etapa" />
				<xs:element ref="referencias" />
				<xs:element ref="fotos" />
				<xs:element ref="videos" />
				<xs:element ref="sonidos" />
				<xs:element ref="lugar_Salida" />
				<xs:element ref="lugar_Meta" />
				<xs:element ref="hitos_Importantes" />
				<xs:element ref="puntos_Anónimos" />
				<xs:element ref="clasificacion_Etapa" />
				<xs:element ref="clasificacion_General" />
				<xs:element ref="clasificacion_Equipos" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!--DATOS-->

	<xs:element name="nombre_Etapa" type="xs:string" />

	<xs:element name="num_Etapa">
		<xs:simpleType>
			<xs:restriction base="xs:nonNegativeInteger">
				<xs:minInclusive value="1" />
				<xs:maxInclusive value="21" />
			</xs:restriction>
		</xs:simpleType>
	</xs:element>

	<xs:element name="longitud_Etapa">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="restriccion_longitud_etapa">
					<xs:attribute fixed="Km" name="unidadLongitud" type="xs:string"  use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>

	</xs:element>

	<xs:simpleType name="restriccion_longitud_etapa">
			<xs:restriction base="xs:decimal">
				<xs:minInclusive value="0"/>
				<xs:maxInclusive value="173.3"/>			
			</xs:restriction>
		</xs:simpleType>

	<xs:element name="fecha" type="xs:date" />
	<xs:element name="tiempo_Ganador" type="xs:duration" />

	<xs:element name="velocidad_Media_Ganador">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="restriccion_velocidad">
					<xs:attribute fixed="Km/h" name="unidadVelocidadMedia" type="xs:string"  use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:simpleType name="restriccion_velocidad">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0" />
			<xs:maxInclusive value="140" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="desnivel">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="restriccion_desnivel">
					<xs:attribute fixed="m" name="unidadDesnivel" type="xs:string"  use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:simpleType name="restriccion_desnivel">
		<xs:restriction base="xs:nonNegativeInteger">
			<xs:minInclusive value="0" />
			<xs:maxInclusive value="6000" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="ciudad_Inicio" type="xs:string" />
	<xs:element name="ciudad_Fin" type="xs:string" />

	<xs:element name="tipo_Etapa">
		<xs:complexType>
			<xs:attribute name="tipo" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="llana" />
						<xs:enumeration value="montaña" />
						<xs:enumeration value="contrarreloj_individual" />
						<xs:enumeration value="contrarreloj_por_equipos" />
						<xs:enumeration value="media_montaña" />
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<xs:element name="referencias">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="referencia" minOccurs="3" maxOccurs="unbounded" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="referencia" type="xs:anyURI" />

	<xs:element name="fotos">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="foto" minOccurs="1" maxOccurs="5" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="foto">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value=".+\.(jpg|png|jpeg|JPG|PNG|JPEG)" />
			</xs:restriction>
		</xs:simpleType>
	</xs:element>

	<xs:element name="videos">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="video" minOccurs="1" maxOccurs="3" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="video">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value=".+\.(mp4|mov|MOV|MP4)" />
			</xs:restriction>
		</xs:simpleType>
	</xs:element>

	<xs:element name="sonidos">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="sonido" minOccurs="1" maxOccurs="3" />
			</xs:sequence>
		</xs:complexType>

	</xs:element>

	<xs:element name="sonido">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value=".+\.(mp3|MP3)" />
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="lugar_Salida">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coordenadas_geograficas" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="lugar_Meta">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coordenadas_geograficas" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="coordenadas_geograficas">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="longitud" />
				<xs:element ref="latitud" />
				<xs:element ref="altitud" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="longitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="restriccion_longitud">
					<xs:attribute fixed="grados" name="unidadLongitud" type="xs:string"  use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:simpleType name="restriccion_longitud">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="-180" />
			<xs:maxInclusive value="180" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="latitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="restriccion_latitud">
					<xs:attribute fixed="grados" name="unidadLatitud" type="xs:string"  use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:simpleType name="restriccion_latitud">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="-90" />
			<xs:maxInclusive value="90" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="altitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="restriccion_altitud">
					<xs:attribute fixed="m" name="unidadAltitud" type="xs:string"  use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:simpleType name="restriccion_altitud">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0" />
			<xs:maxInclusive value="3000" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="hitos_Importantes">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="puerto_montaña" />
				<xs:element ref="sprint_intermedio" />
				<xs:element ref="sprint_bonificado" />
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="puerto_montaña">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coordenadas_geograficas" />
				<xs:element ref="distancia" />
			</xs:sequence>
			<xs:attribute name="nombre" type="xs:string" use="required" />
			<xs:attribute name="categoria" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="primera" />
						<xs:enumeration value="segunda" />
						<xs:enumeration value="tercera" />
						<xs:enumeration value="especial" />
						<xs:enumeration value="bonificado" />
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<xs:element name="sprint_intermedio">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coordenadas_geograficas" />
				<xs:element ref="distancia" />
			</xs:sequence>
			<xs:attribute name="nombre" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>

	<xs:element name="sprint_bonificado">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coordenadas_geograficas" />
				<xs:element ref="distancia" />
			</xs:sequence>
			<xs:attribute name="nombre" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>

	<xs:element name="distancia">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="restriccion_distancia">
					<xs:attribute fixed="Km" name="unidadDistancia" type="xs:string"  use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:simpleType name="restriccion_distancia">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0" />
			<xs:maxInclusive value="173.3" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="puntos_Anónimos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" maxOccurs="unbounded" ref="puntoAnónimo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="puntoAnónimo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coordenadas_geograficas" />
				<xs:element ref="distancia" />
			</xs:sequence>
			<xs:attribute name="nombre" type="xs:string" />
		</xs:complexType>
	</xs:element>
	<xs:element name="clasificacion_Etapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="primero" />
				<xs:element ref="segundo" />
				<xs:element ref="tercero" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="primero">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ciclista" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="segundo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ciclista" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="tercero">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ciclista" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>

	</xs:element>
	<xs:element name="ciclista" type="xs:string" />
	<xs:element name="diferencia" type="xs:duration" />
	<xs:element name="clasificacion_General">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="primero" />
				<xs:element ref="segundo" />
				<xs:element ref="tercero" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="clasificacion_Equipos">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="primerEquipo" />
				<xs:element ref="segundoEquipo" />
				<xs:element ref="tercerEquipo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="primerEquipo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="equipo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="segundoEquipo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="equipo" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="tercerEquipo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="equipo" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="equipo" type="xs:string" />

</xs:schema>